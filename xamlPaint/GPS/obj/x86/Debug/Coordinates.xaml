<Page
    x:Class="GPS.Coordinates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GPS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:ConnectionId='2'
                                        >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel
        Grid.Row="0">
            <TextBlock
                Text="GPS"
                Style="{ThemeResource BaseTextBlockStyle}"
                FontSize="20"
                Margin="15 10 0 10"
                />
            <TextBlock
                Text="Coordinates"
                Style="{ThemeResource HeaderTextBlockStyle}"
                HorizontalAlignment="Left"
                Margin="30 0 0 8"
                />

        </StackPanel>
        <StackPanel
            Grid.Row="1"
            >
            <TextBlock
                Text="GPS: My coordinates"
                HorizontalAlignment="Center"
                FontSize="30"
                />
            <TextBlock x:ConnectionId='5'
                x:Name="CurrentCoordinates"
                Text="***"
                HorizontalAlignment="Center"
                Margin="0 10 0 10"
                />
            <TextBlock
                Text="Search for address:"
                HorizontalAlignment="Center"
                FontSize="24"
                Margin="0 0 0 6"
                />
            <TextBox x:ConnectionId='6'
                x:Name="SelectedAddress"
                />
            <Grid
                Margin="10 30 0 0"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Text="Selected location Coordinates"
                    HorizontalAlignment="Center"
                    FontSize="18"
                    Margin="0 0 0 10"
                    />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Geographical length: "
                    HorizontalAlignment="Center"
                    Margin="0 0 0 6"
                    />
                <TextBlock x:ConnectionId='7'
                    Grid.Row="1"
                    Grid.Column="1"
                    x:Name="GeographicalLength"
                    />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Geographical Width: "
                    HorizontalAlignment="Center"
                    />
                <TextBlock x:ConnectionId='8'
                    Grid.Row="2"
                    Grid.Column="1"
                    x:Name="GeographicalWidth"
                    />
            </Grid>
                
            </StackPanel>
        <CommandBar
        Grid.Row="2"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        >
            <AppBarButton x:ConnectionId='3'
                x:Name="Back"
                Label="Back"
                                     
                Icon="Back"
                Margin="0 0 300 0"
                />
            <AppBarButton x:ConnectionId='4'
                x:Name="Search"
                Label="Search"
                Icon="Find"
                                       
            />
        </CommandBar>
    </Grid>
</Page>

