<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GPS"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Custom="using:Windows.UI.Xaml.Controls.Maps"
    x:Class="GPS.MainPage"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0">
        <TextBlock
            Text="GPS"
            Style="{ThemeResource BaseTextBlockStyle}"
            FontSize="20"
            Margin="15 10 0 10"
            />
            <TextBlock
            Text="Map"
            Style="{ThemeResource HeaderTextBlockStyle}"
            HorizontalAlignment="Left"
            Margin="30 0 0 8"
            />
        </StackPanel>
        <Custom:MapControl x:ConnectionId='2'
            x:Name="AppMap"
            Grid.Row="1"
            MapServiceToken="uLuoAZIJ4QgeZCbWJCwH~LdHZdGvIAqRoeRuB5wtlqw~Am3PkgR4uoZTqpYuq9tRtli1d57wH1gziTob9pVUdPqo_FMhI2MhCVDD3iVESIZQ"
            />
        <CommandBar
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            >
            <AppBarButton x:ConnectionId='3'
                x:Name="ZoomIn"
                Icon="Add"
                Label="Powiększ"
                                       
                />
            <AppBarButton x:ConnectionId='4'
                x:Name="ZoomOut"
                Icon="Remove"
                Label="Zmniejsz"
                                        
                />
            <AppBarButton x:ConnectionId='5'
                x:Name="SateliteView"
                Label="Satelita"
                                         
                >
                <AppBarButton.Icon>
                    <FontIcon Glyph="S" FontFamily="auto"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton x:ConnectionId='6'
                x:Name="Coordinates"
                Label="Koordynaty"
                Icon="Globe"
                                            
                />
        </CommandBar>
    </Grid>
</Page>

